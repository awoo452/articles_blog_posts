<% content_for :title, "Articles" %>

<h1>Articles</h1>

<% if @articles.any? %>
  <ul>
    <% @articles.each do |article| %>
      <li>
        <h2><%= link_to article.title, article_path(article) %></h2>
        <p>
          <strong><%= article.content_type.humanize %></strong>
          ·
          <%= (article.published_at || article.created_at).to_date.to_s %>
        </p>
        <p><%= article.summary %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No published articles yet.</p>
<% end %>
